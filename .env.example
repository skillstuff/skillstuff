# ==============================================================================
# SkillStuff Platform Environment Configuration Example
# Copy this file to '.env' and populate with your local / deployment credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Prisma ORM)
# ------------------------------------------------------------------------------
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE_NAME>?schema=<SCHEMA>
# Default local PostgreSQL connection string:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skillstuff?schema=public"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Secret key used for signing JWT authentication tokens (use a strong random string in production)
JWT_SECRET="your-super-secret-jwt-key-min-32-characters-long"

# Environment Mode: 'development', 'production', or 'test'
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 3. SITE URL & SEO METADATA
# ------------------------------------------------------------------------------
# Canonical public URL of your application (no trailing slash)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Public site title / brand name
NEXT_PUBLIC_SITE_NAME="SkillStuff"

# ------------------------------------------------------------------------------
# 4. ANALYTICS & MONETIZATION
# ------------------------------------------------------------------------------
# Google AdSense Publisher Client ID (Format: ca-pub-XXXXXXXXXXXXXXXX)
NEXT_PUBLIC_ADSENSE_CLIENT_ID="ca-pub-1234567890123456"

# Google Analytics Measurement ID (Format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# ------------------------------------------------------------------------------
# 5. STORAGE & EXTERNAL SERVICES (OPTIONAL)
# ------------------------------------------------------------------------------
# Optional Cloudinary or S3 configuration for media uploads
# CLOUDINARY_URL=""
# AWS_S3_BUCKET_NAME=""
